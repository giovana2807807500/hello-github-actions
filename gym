<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Academia StrongFit</title>
  <link rel="stylesheet" href="style.css"/>
</head>
<body>
  <header>
    <h1>🏋️‍♂️ StrongFit Academia</h1>
    <nav>
      <ul>
        <li><a href="#">Início</a></li>
        <li><a href="#">Serviços</a></li>
        <li><a href="#">Planos</a></li>
        <li><a href="#">Contato</a></li>
      </ul>
    </nav>
  </header>

  <section class="hero">
    <h2>Transforme seu corpo, mude sua vida!</h2>
    <p>Treinos personalizados, musculação, funcional e muito mais.</p>
    <button onclick="faleConosco()">Fale Conosco</button>
  </section>

  <section class="services">
    <h3>Nossos Serviços</h3>
    <ul>
      <li>💪 Musculação</li>
      <li>🔥 Treinamento Funcional</li>
